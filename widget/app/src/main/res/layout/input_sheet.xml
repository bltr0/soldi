<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/input_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/fx_label"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/amount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:hint="0"
            android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="12"
            android:singleLine="true"
            android:textColor="@color/fx_krw"
            android:textColorHint="@color/fx_placeholder"
            android:textSize="28sp" />

        <ImageButton
            android:id="@+id/convert"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/convert_button"
            android:contentDescription="@string/convert"
            android:src="@drawable/ic_arrow" />
    </LinearLayout>
</FrameLayout>
