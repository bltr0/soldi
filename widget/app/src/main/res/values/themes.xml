<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FxInput" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:colorAccent">@color/fx_eur</item>
        <item name="android:colorControlActivated">@color/fx_eur</item>
    </style>

    <style name="Theme.FxSettings" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fx_bg_bottom</item>
        <item name="android:statusBarColor">@color/fx_bg_bottom</item>
        <item name="android:navigationBarColor">@color/fx_bg_bottom</item>
        <item name="android:colorAccent">@color/fx_eur</item>
        <item name="android:colorControlActivated">@color/fx_eur</item>
    </style>

    <style name="SettingsSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/fx_faint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/settings_card</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="SettingsTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/fx_eur</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/fx_label</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/fx_faint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@color/fx_krw</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:background">@color/fx_hairline</item>
    </style>

    <style name="FxState">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="FxLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/fx_label</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="FxValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/fx_eur</item>
        <item name="android:textSize">25sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">14sp</item>
        <item name="android:autoSizeMaxTextSize">25sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <style name="FxFooter" parent="FxLabel">
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/fx_faint</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
